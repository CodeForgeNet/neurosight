include neurosight/data/connectome_weights.json
include neurosight/py.typed
include README.md
include LICENSE
include CHANGELOG.md
include CONTRIBUTING.md
include SECURITY.md
include CODE_OF_CONDUCT.md
recursive-include tests *.py

# macOS AppleDouble / Finder metadata can appear on external or network
# volumes; never ship it in an sdist or wheel.
global-exclude ._*
global-exclude .DS_Store
global-exclude *.py[cod]
